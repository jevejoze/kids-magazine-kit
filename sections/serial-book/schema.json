{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "经典连载 · 书 18-serial.json",
  "type": "object",
  "required": [
    "kind",
    "ep",
    "book_zh",
    "book_en",
    "chapter",
    "title_zh",
    "paragraphs",
    "quote",
    "crew",
    "guess",
    "tbc",
    "photo_url",
    "photo_credit"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "crew": {
      "type": "object",
      "required": [
        "who",
        "say"
      ],
      "properties": {
        "who": {
          "type": "string",
          "pattern": "^[a-z]+:[a-z]+:[0-9]+(:[a-z+]+)?$"
        },
        "say": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      }
    },
    "photo_url": {
      "type": "string",
      "minLength": 1
    },
    "photo_credit": {
      "type": "string",
      "minLength": 1
    },
    "photo_pos": {
      "type": "string"
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tbc": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "bible_update": {
      "type": "string"
    },
    "title_zh": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "book"
    },
    "ep": {
      "type": "integer",
      "minimum": 1
    },
    "book_zh": {
      "type": "string",
      "minLength": 1
    },
    "book_en": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "chapter": {
      "type": "string",
      "minLength": 1
    },
    "quote": {
      "type": "object",
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "who": {
          "type": "string"
        }
      }
    },
    "guess": {
      "type": "string",
      "minLength": 1
    }
  }
}
