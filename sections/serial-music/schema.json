{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "经典连载 · 音乐盒 serial.json",
  "type": "object",
  "required": [
    "kind",
    "title_zh",
    "title_en",
    "by",
    "paragraphs",
    "tasks",
    "crew",
    "where",
    "photo_url",
    "photo_credit"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "crew": {
      "type": "object",
      "required": [
        "who",
        "say"
      ],
      "properties": {
        "who": {
          "type": "string",
          "pattern": "^[a-z]+:[a-z]+:[0-9]+(:[a-z+]+)?$"
        },
        "say": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      }
    },
    "photo_url": {
      "type": "string",
      "minLength": 1
    },
    "photo_credit": {
      "type": "string",
      "minLength": 1
    },
    "photo_pos": {
      "type": "string"
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tbc": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "bible_update": {
      "type": "string"
    },
    "title_zh": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "music"
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "where": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
