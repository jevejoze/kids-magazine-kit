{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "单词屋 12-words.json",
  "type": "object",
  "required": ["intro", "grammar", "items", "task"],
  "properties": {
    "_meta": { "type": "object", "properties": { "ticket": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "intro": { "type": "string", "minLength": 1 },
    "grammar": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["word", "cn", "example", "icon"],
        "properties": {
          "word": { "type": "string" }, "cn": { "type": "string" },
          "example": { "type": "string" }, "icon": { "type": "string" }, "new": { "type": "boolean" }
        }
      }
    },
    "task": { "type": "string", "minLength": 1 },
    "lines": { "type": "integer" }
  }
}
