{
  "about": "一期杂志的流水线。每步读 inputs、写 outputs；depends 里的步骤全部完成后才能开始。带 section 的步骤属于一个栏目：栏目在 brief.json 的 sections 里才做，否则算本期不出（sections 由 pipeline.mjs schedule 按 magazine.yaml 和日期算出）；没有 sections 的旧任务书照旧看 creature、think 字段，单词屋、英文三关默认不做。kind=agent 的步骤由任意 agent 按 stages/<id>.md 完成；kind=script 的步骤在任意有 Node、Chrome、ffmpeg 的环境里运行。路径：data/ 是数据目录，issue/ 是 data/issues/NNN/。",
  "stages": [
    {"id": "brief",     "title": "本期任务书",   "kind": "agent",  "depends": [],
     "inputs": ["data/MY_CHILD.md", "data/profile.md", "data/curation-log.md", "data/child-questions.md", "data/state/story/", "data/serial-bible.md", "data/think-log.md", "data/thinking-plan.md", "上一期 issue/issue.json"],
     "outputs": ["issue/brief.json"]},
    {"id": "think",     "title": "周末思辨",     "kind": "agent",  "section": "think", "depends": ["brief"], "outputs": ["issue/think.json"]},
    {"id": "creature",  "title": "传说怪物档案", "kind": "agent",  "section": "creature", "depends": ["brief"], "outputs": ["issue/creature.json"]},
    {"id": "cover",     "title": "封面选题",     "kind": "agent",  "section": "cover", "depends": ["brief"],  "outputs": ["issue/cover.json"]},
    {"id": "comic",     "title": "今日一问",     "kind": "agent",  "section": "comic", "depends": ["cover"],  "outputs": ["issue/comic.json", "issue/diagram.svg"]},
    {"id": "words",     "title": "单词屋",       "kind": "agent",  "section": "words", "depends": ["brief"], "outputs": ["issue/words.json"]},
    {"id": "story",     "title": "小剧场",       "kind": "agent",  "section": "story", "depends": ["brief"],  "outputs": ["issue/story.json"]},
    {"id": "challenge",    "title": "谜题",         "kind": "agent",  "section": "challenge", "depends": ["brief"],  "outputs": ["issue/challenge.json"]},
    {"id": "english",   "title": "英文三关",     "kind": "agent",  "section": "english", "depends": ["brief"], "outputs": ["issue/english.json"]},
    {"id": "mailbox",   "title": "信箱",         "kind": "agent",  "section": "mailbox", "depends": ["brief"],  "outputs": ["issue/mailbox.json"]},
    {"id": "news",      "title": "环球小报",     "kind": "agent",  "section": "news", "depends": ["brief"],  "outputs": ["issue/news.json"]},
    {"id": "serial",    "title": "经典连载",     "kind": "agent",  "section": "serial", "depends": ["brief"],  "outputs": ["issue/serial.json"]},
    {"id": "check",     "title": "真的假的",     "kind": "agent",  "section": "check", "depends": ["brief"],  "outputs": ["issue/check.json"]},
    {"id": "assets",    "title": "下载图片",     "kind": "agent",  "depends": ["think", "creature", "cover", "news", "serial", "check"], "outputs": ["issue/assets/assets.json"]},
    {"id": "assemble",  "title": "合并整期",     "kind": "script", "depends": ["think", "creature", "comic", "story", "challenge", "mailbox", "news", "serial", "check", "assets"],
     "run": "node scripts/pipeline.mjs assemble <issue>", "outputs": ["issue/issue.json"]},
    {"id": "review",    "title": "审稿",         "kind": "agent",  "depends": ["assemble"], "outputs": ["issue/review.md"]},
    {"id": "render",    "title": "渲染图片和 PDF", "kind": "script", "depends": ["review"],
     "run": "node scripts/render.mjs <issue>/issue.json <issue>/cards --flat", "outputs": ["issue/cards/"]},
    {"id": "narration", "title": "讲读稿",       "kind": "agent",  "depends": ["review"], "outputs": ["issue/narration.json"]},
    {"id": "audio",     "title": "语音",         "kind": "script", "depends": ["narration"],
     "run": "node scripts/tts_azure.mjs <issue>", "outputs": ["issue/audio/"]},
    {"id": "video",     "title": "讲读视频",     "kind": "script", "depends": ["render", "audio"],
     "run": "python3 scripts/make_video.py <issue>", "outputs": ["issue/final/"]},
    {"id": "archive",   "title": "更新档案",     "kind": "agent",  "depends": ["render"],
     "outputs": ["issue/archive.json"]}
  ]
}
